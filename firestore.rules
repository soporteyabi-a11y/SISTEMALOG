rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Operational and sync collections for multi-PC collaboration
    match /app_state/{docId} {
      allow read, write: if true;
    }

    match /provisiones_state/{docId} {
      allow read, write: if true;
    }

    match /citas_state/{docId} {
      allow read, write: if true;
    }

    match /pedidos_empleados_state/{docId} {
      allow read, write: if true;
    }

    match /liq_state/{docId} {
      allow read, write: if true;
    }

    match /horas_extras_state/{docId} {
      allow read, write: if true;
    }

    match /sync_queue/{docId} {
      allow read, write: if true;
    }

    match /sync_logs/{docId} {
      allow read, write: if true;
    }

    match /analisis_sync_logs/{docId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
